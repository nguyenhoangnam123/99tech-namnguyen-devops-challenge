          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(matcher_command_age_seconds_bucket{service=\"matcher\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "refId": "B"
