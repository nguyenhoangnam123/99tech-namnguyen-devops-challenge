{
  "name": "exchange",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19 <23"
  },
  "workspaces": [
    "packages/core",
    "packages/contracts",
    "packages/codecs",
    "packages/platform",
    "services/oms",
    "services/matcher",
    "services/marketdata",
    "tests"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "lint": "eslint . && depcruise packages services --config .dependency-cruiser.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen": "node scripts/gen.mjs",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:security": "vitest run --project security",
    "test:coverage": "vitest run --project unit --coverage",
    "typecheck": "tsc -b && tsc -p tsconfig.check.json"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.75.0",
    "@bufbuild/protoc-gen-es": "2.17.0",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "dependency-cruiser": "18.8.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.10.2",
    "kysely-codegen": "0.20.0",
    "openapi-typescript": "7.13.0",
    "pg": "8.23.1",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0"
  }
}
